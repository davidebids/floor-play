{
  "name": "projection-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5188",
    "test": "vitest run",
    "start": "vite --host 127.0.0.1 --port 5188",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src/projection tests/e2e playwright.config.ts vitest.config.ts",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs --manifest artifacts/evidence.json",
    "verify:visual": "python3 scripts/check-evidence.py . --manifest artifacts/evidence.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.2"
  }
}
